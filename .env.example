# Dedicated app-owned database/role, not the shared PostgreSQL administrator.
# URL-encode special characters in the password. localhost for non-Docker dev;
# postgres is the existing shared service's DNS name on ai_platform.
DATABASE_URL=******postgres:5432/resume_builder
API_TOKEN=
ALLOW_UNAUTHENTICATED=false
PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=resume-artifacts
DATA_DIR=/app/data
INBOX_DIR=/app/inbox/json
ASSETS_DIR=/app/assets
PROMPTS_DIR=/app/prompts
POLL_SECONDS=5
LEASE_SECONDS=600
MAX_ATTEMPTS=3
