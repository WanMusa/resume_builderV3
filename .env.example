# Dedicated app-owned database/role, not the shared PostgreSQL administrator.
# Supply the dedicated app password separately through DATABASE_PASSWORD.
# localhost for non-Docker dev; postgres is shared service DNS on ai_platform.
DATABASE_URL=postgresql+psycopg://resume_builder@postgres:5432/resume_builder
DATABASE_PASSWORD=
API_TOKEN=
ALLOW_UNAUTHENTICATED=false
PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=resume-artifacts
DATA_DIR=/app/data
INBOX_DIR=/app/inbox/json
ASSETS_DIR=/app/assets
PROMPTS_DIR=/app/prompts
POLL_SECONDS=5
LEASE_SECONDS=600
MAX_ATTEMPTS=3
