# Dedicated app-owned database/role, not the shared PostgreSQL administrator.
# Deployment merges database, API, Job Runs, OpenAI and Supabase settings from Actions secrets.
# DB_USER is a deployment-only admin login; the app always uses resume_builder.
# localhost for non-Docker dev; postgres is shared service DNS on ai_platform.
DATABASE_URL=postgresql+psycopg://resume_builder@postgres:5432/resume_builder
DATABASE_PASSWORD=
API_TOKEN=
# Separate, least-privilege credential for the Chrome extension's Job Runs view.
JOB_RUNS_API_TOKEN=
ALLOW_UNAUTHENTICATED=false
PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=generated-documents
DATA_DIR=/app/data
INBOX_DIR=/app/inbox/json
ASSETS_DIR=/app/assets
PROMPTS_DIR=/app/prompts
POLL_SECONDS=5
LEASE_SECONDS=600
MAX_ATTEMPTS=3
# Shared nginx-proxy hostname; only /resume/ routes to this API.
APP_DOMAIN=wanagents.duckdns.org
# Optional host loopback port (container API always uses 8000).
RESUME_BUILDER_PORT=8000
